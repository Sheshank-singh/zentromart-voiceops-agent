# Copy to .env and fill in. Never commit .env.

# Gnani speech (STT + TTS): https://app.gnani.ai/voice
GNANI_API_KEY=

# LLM: Sarvam (default). Key from https://dashboard.sarvam.ai
SARVAM_API_KEY=
LLM_MODEL=sarvam-105b

# Alternative: Google Gemini (used when SARVAM_API_KEY is empty)
# GEMINI_API_KEY=
# Thinking level: low keeps voice turns fast; medium/high trade latency for more careful answers
LLM_EFFORT=low

# Optional alternative: Anthropic Claude (set LLM_PROVIDER=anthropic)
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5
# LLM_FALLBACKS=1

# Where the extracted Capstone_Project_Dataset_FTTT_2026 folder lives
# (auto-detected if it sits in the project root or in ./dataset)
DATASET_DIR=

# Retrieval
TOP_K=8
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Voice
STT_LANGUAGE=en-IN
TTS_LANGUAGE=en-IN
TTS_VOICE=Kaveri
TTS_MODEL=timbre-v2.5
